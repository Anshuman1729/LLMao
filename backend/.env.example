SARVAM_API_KEY=your_sarvam_api_key_here
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
MOCK_AUTH=true

# --- Production (Vercel) values ---
# JWT_SECRET=generate-a-long-random-string-here  (e.g. openssl rand -hex 32)
# INSTAGRAM_REDIRECT_URI=https://your-backend.vercel.app/auth/instagram/callback
# COOKIE_SAMESITE=None  (cross-site cookies require None + Secure in prod)
# FRONTEND_URL=https://your-frontend.vercel.app

# --- Local dev values ---
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback
# COOKIE_SAMESITE=Lax
# FRONTEND_URL=http://localhost:3000
